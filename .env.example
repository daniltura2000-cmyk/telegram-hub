# ===== TelegramHub — приклад конфігурації =====
# Скопіюйте цей файл у .env і заповніть значення:  cp .env.example .env

# Токен контрольного бота (отримати у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAAyour_bot_token_here

# ID адміністраторів через кому (лише вони керують ботом)
ADMIN_IDS=123456789

# Дані з my.telegram.org → API development tools (для підключення ВАШОГО акаунта)
# Необов'язково: можна ввести й через меню «Підключити акаунт» у боту.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Шлях до бази даних SQLite (за замовчуванням data/hub.db)
DATABASE_PATH=data/hub.db

# Таймаут запитів до LLM, секунд (за замовчуванням 60)
LLM_TIMEOUT=60

# Скільки повідомлень на чат брати для аналізу стилю (за замовчуванням 500)
ANALYSIS_LIMIT=500

# Рівень логування: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Ліміт токенів на одну чат-відповідь (менше = швидше і коротше)
LLM_MAX_TOKENS=200
